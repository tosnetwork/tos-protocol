{
  "version": "1",
  "network": "testnet",
  "endpoints": [
    "https://rpc-1.example/jsonRPC",
    "https://rpc-2.example/jsonRPC",
    "https://rpc-3.example/jsonRPC"
  ],
  "quorum": 2,
  "queryTimeoutMillis": 5000,
