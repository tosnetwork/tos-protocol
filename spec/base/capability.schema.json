{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capability.schema.json",
  "title": "TOS capability claim",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "evidence"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/serviceId"},
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00]+$"
    },
    "evidence": {"$ref": "common.schema.json#/$defs/evidenceLevel"},
    "attributes": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {"$ref": "common.schema.json#/$defs/serviceId"},
      "additionalProperties": {
        "type": "string",
        "maxLength": 1024,
        "pattern": "^[^\\x00]*$"
      }
    }
  }
}
