{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "error.schema.json",
  "title": "TOS protocol error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message", "retry"],
  "properties": {
    "code": {
      "enum": [
        "INVALID_ARGUMENT",
        "UNSUPPORTED_VERSION",
        "AUTHENTICATION_FAILED",
        "AUTHORIZATION_DENIED",
        "REPLAY_DETECTED",
        "QUOTE_EXPIRED",
        "QUOTE_MISMATCH",
        "PAYMENT_REQUIRED",
        "PAYMENT_UNCONFIRMED",
        "PAYMENT_REORGANIZED",
        "ADMISSION_REJECTED",
        "RESOURCE_EXHAUSTED",
        "DEADLINE_EXCEEDED",
        "CANCELED",
        "RUNTIME_FAILED",
        "EVIDENCE_INVALID",
        "SETTLEMENT_PENDING",
        "INTERNAL"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[^\\x00]+$"
    },
    "retry": {
      "enum": [
        "never",
        "safe",
        "after-delay",
        "after-reauthorize",
        "after-payment",
        "after-state-change"
      ]
    },
    "retryAfterMillis": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400000
    },
    "details": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"$ref": "common.schema.json#/$defs/serviceId"},
      "additionalProperties": {
        "type": "string",
        "maxLength": 512,
        "pattern": "^[^\\x00]*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"retry": {"const": "after-delay"}},
        "required": ["retry"]
      },
      "then": {"required": ["retryAfterMillis"]},
      "else": {"not": {"required": ["retryAfterMillis"]}}
    }
  ]
}
