{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "signed-envelope.schema.json",
  "title": "TOS signed envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "domain",
    "keyId",
    "issuedAt",
    "expiresAt",
    "nonce",
    "payload",
    "signature"
  ],
  "properties": {
    "version": {"const": 1},
    "domain": {
      "type": "string",
      "minLength": 5,
      "maxLength": 128,
      "pattern": "^tos\\.[a-z0-9.-]+$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\x00]+$"
    },
    "issuedAt": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "expiresAt": {
      "type": "integer",
      "minimum": -9223372036854775808,
      "maximum": 9223372036854775807
    },
    "nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "payload": {
      "type": "string",
      "maxLength": 1398104,
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  }
}
