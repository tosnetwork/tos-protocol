{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.schema.json",
  "title": "TOS session grant v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "sessionId",
    "serviceId",
    "profileId",
    "profileVersion",
    "client",
    "runtimeKeyId",
    "manifestRevision",
    "operations",
    "maxRequests",
    "maxNanoTos",
    "issuedAt",
    "expiresAt"
  ],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/protocolVersion"},
    "sessionId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "serviceId": {"$ref": "common.schema.json#/$defs/serviceId"},
    "profileId": {"$ref": "common.schema.json#/$defs/serviceId"},
    "profileVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 32
    },
    "profileExtensions": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256,
        "pattern": "^\\S+$"
      }
    },
    "client": {"$ref": "common.schema.json#/$defs/boundedString"},
    "runtimeKeyId": {"$ref": "common.schema.json#/$defs/boundedString"},
    "manifestRevision": {"$ref": "common.schema.json#/$defs/boundedString"},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\\x00]+$"
      }
    },
    "maxRequests": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "maxNanoTos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "issuedAt": {"$ref": "common.schema.json#/$defs/dateTime"},
    "expiresAt": {"$ref": "common.schema.json#/$defs/dateTime"}
  }
}
