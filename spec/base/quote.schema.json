{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quote.schema.json",
  "title": "TOS quote v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "quoteId",
    "requestId",
    "sessionId",
    "serviceId",
    "profileId",
    "operation",
    "intentDigest",
    "serviceRevision",
    "resourceRevision",
    "network",
    "payee",
    "settlement",
    "priceNanoTos",
    "maxInputBytes",
    "maxOutputBytes",
    "issuedAt",
    "deadline",
    "expiresAt"
  ],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/protocolVersion"},
    "quoteId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "requestId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "sessionId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "serviceId": {"$ref": "common.schema.json#/$defs/serviceId"},
    "profileId": {"$ref": "common.schema.json#/$defs/serviceId"},
    "operation": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00]+$"
    },
    "intentDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "serviceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00]+$"
    },
    "resourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00]+$"
    },
    "network": {"$ref": "common.schema.json#/$defs/boundedString"},
    "payee": {"$ref": "common.schema.json#/$defs/boundedString"},
    "settlement": {"$ref": "common.schema.json#/$defs/boundedString"},
    "priceNanoTos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "maxInputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "maxOutputBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "resourceLimits": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "resource-limit.schema.json"}
    },
    "issuedAt": {"$ref": "common.schema.json#/$defs/dateTime"},
    "deadline": {"$ref": "common.schema.json#/$defs/dateTime"},
    "expiresAt": {"$ref": "common.schema.json#/$defs/dateTime"}
  }
}
