{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "profile-negotiation.schema.json",
  "title": "TOS profile negotiation values",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/offer"},
    {"$ref": "#/$defs/negotiated"}
  ],
  "$defs": {
    "extensionList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 256,
        "pattern": "^\\S+$"
      }
    },
    "versionList": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "common.schema.json#/$defs/semanticVersion"}
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "supportedVersions"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/serviceId"},
        "supportedVersions": {"$ref": "#/$defs/versionList"},
        "supportedExtensions": {"$ref": "#/$defs/extensionList"}
      }
    },
    "offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "versions"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/serviceId"},
        "versions": {"$ref": "#/$defs/versionList"},
        "criticalExtensions": {"$ref": "#/$defs/extensionList"}
      }
    },
    "negotiated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/serviceId"},
        "version": {"$ref": "common.schema.json#/$defs/semanticVersion"},
        "extensions": {"$ref": "#/$defs/extensionList"}
      }
    }
  }
}
