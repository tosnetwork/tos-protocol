{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service-manifest.schema.json",
  "title": "TOS operational service manifest v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "manifestId",
    "serviceId",
    "controller",
    "network",
    "revision",
    "issuedAt",
    "expiresAt",
    "runtimeKeys",
    "endpoints",
    "profiles"
  ],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/protocolVersion"},
    "manifestId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "serviceId": {"$ref": "common.schema.json#/$defs/serviceId"},
    "controller": {"$ref": "common.schema.json#/$defs/boundedString"},
    "network": {"$ref": "common.schema.json#/$defs/boundedString"},
    "revision": {"$ref": "common.schema.json#/$defs/boundedString"},
    "issuedAt": {"$ref": "common.schema.json#/$defs/dateTime"},
    "expiresAt": {"$ref": "common.schema.json#/$defs/dateTime"},
    "runtimeKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/runtimeKey"}
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/endpoint"}
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/profileReference"}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "capability.schema.json"}
    },
    "extensions": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/extension"}
    }
  },
  "$defs": {
    "runtimeKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "publicKey", "roles", "notBefore", "notAfter"],
      "properties": {
        "keyId": {"$ref": "common.schema.json#/$defs/boundedString"},
        "algorithm": {"const": "Ed25519"},
        "publicKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": ["authenticate", "quote", "receipt", "evidence"]
          }
        },
        "notBefore": {"$ref": "common.schema.json#/$defs/dateTime"},
        "notAfter": {"$ref": "common.schema.json#/$defs/dateTime"}
      }
    },
    "endpoint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "audience", "url"],
          "properties": {
            "transport": {"const": "https"},
            "audience": {"enum": ["public", "authenticated", "private"]},
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "audience", "adnlAddress"],
          "properties": {
            "transport": {"const": "rldp"},
            "audience": {"enum": ["public", "authenticated", "private"]},
            "adnlAddress": {
              "type": "string",
              "minLength": 16,
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "audience", "url"],
          "properties": {
            "transport": {"const": "relay"},
            "audience": {"enum": ["public", "authenticated", "private"]},
            "url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 4096
            }
          }
        }
      ]
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "critical", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 256,
          "pattern": "^\\S+$"
        },
        "critical": {"type": "boolean"},
        "digest": {"$ref": "common.schema.json#/$defs/digest"},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "maxLength": 4096
        }
      }
    }
  }
}
