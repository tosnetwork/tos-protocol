{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "receipt.schema.json",
  "title": "TOS service receipt v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "receiptId",
    "requestId",
    "quoteId",
    "authorizationId",
    "serviceId",
    "status",
    "usage",
    "chargedNanoTos",
    "serviceRevision",
    "resourceRevision",
    "completedAt"
  ],
  "properties": {
    "version": {"$ref": "common.schema.json#/$defs/protocolVersion"},
    "receiptId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "requestId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "quoteId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "authorizationId": {"$ref": "common.schema.json#/$defs/correlationId"},
    "serviceId": {"$ref": "common.schema.json#/$defs/serviceId"},
    "status": {
      "enum": ["succeeded", "failed", "canceled", "timed_out"]
    },
    "usage": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "common.schema.json#/$defs/usageItem"}
    },
    "chargedNanoTos": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "resultDigest": {"$ref": "common.schema.json#/$defs/digest"},
    "serviceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\x00]+$"
    },
    "resourceRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\x00]+$"
    },
    "completedAt": {"$ref": "common.schema.json#/$defs/dateTime"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "succeeded"}},
        "required": ["status"]
      },
      "then": {"required": ["resultDigest"]}
    }
  ]
}
