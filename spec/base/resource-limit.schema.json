{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-limit.schema.json",
  "title": "TOS resource admission limit",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "unit", "quantity"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/serviceId"},
    "unit": {
      "enum": [
        "count",
        "bytes",
        "milliseconds",
        "milliwatts",
        "bits-per-second"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    }
  }
}
